# Project Configuration
PROJECT_NAME="Service Booking Platform API"
VERSION="0.1.0"
ENV="development"
PORT=8000

# Database Configuration
# Use 'localhost' for local development, or 'postgres' when running inside Docker Compose
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/booking_db"

# Redis Configuration
# Use 'localhost' for local development, or 'redis' when running inside Docker Compose
REDIS_URL="redis://localhost:6379/0"

# Security Configuration
SECRET_KEY="dev-secret-key-change-in-production-1234567890"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
